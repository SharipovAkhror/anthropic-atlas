{
  "name": "anthropic-atlas",
  "private": true,
  "type": "module",
  "description": "Anthropic Atlas: a daily-updated public-source monitor of Anthropic.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run validate && npm run test && npm run guard",
    "test": "node scripts/test.mjs",
    "validate": "node scripts/validate.mjs",
    "guard": "node scripts/guard.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "qa": "npm run check && npm run smoke && npm run e2e",
    "today": "node scripts/today.mjs",
    "collect": "node scripts/collect.mjs",
    "library": "node scripts/library.mjs",
    "digest": "node scripts/digest.mjs",
    "enrich": "node scripts/enrich.mjs",
    "links": "node scripts/links.mjs",
    "serve": "npx --yes serve@14.2.4 -l 4173 ."
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
