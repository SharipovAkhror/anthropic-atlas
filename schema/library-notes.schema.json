{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "library-notes.schema.json",
  "title": "Editorial layer over the library (data/library-notes.json): Russian cards and reading paths. Optional: the site works without it.",
  "type": "object",
  "required": ["notes", "paths"],
  "additionalProperties": false,
  "properties": {
    "notes": { "type": "object", "additionalProperties": {
      "type": "object", "required": ["t", "s"], "additionalProperties": false,
      "properties": {
        "t": { "type": "string", "minLength": 1, "maxLength": 140 },
        "s": { "type": "string", "minLength": 1, "maxLength": 320 },
        "w": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "library.schema.json#/definitions/audience" } },
        "d": { "type": "string", "maxLength": 140 }
      } } },
    "paths": { "type": "array", "items": {
      "type": "object", "required": ["id", "ru", "en", "items"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "ru": { "type": "string" }, "en": { "type": "string" }, "uz": { "type": "string" },
        "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "why"], "additionalProperties": false,
          "properties": { "id": { "type": "string" }, "why": { "type": "string", "maxLength": 160 } } } }
      } } }
  }
}
