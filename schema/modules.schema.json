{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "modules.schema.json",
  "title": "Board layout: which modules (sections) are shown and in what order (data/modules.json)",
  "type": "object",
  "required": ["modules"],
  "additionalProperties": false,
  "properties": {
    "modules": { "type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "renderer", "title"],
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/id" },
        "renderer": { "enum": ["digest", "facts", "timeline", "governance", "people", "products", "glossary", "cards", "library", "saved"], "description": "Which built-in renderer draws the module" },
        "title": { "$ref": "common.schema.json#/definitions/i18nFull" },
        "lead": { "$ref": "common.schema.json#/definitions/i18n" },
        "source": { "type": "string", "description": "Dataset path inside the data folder, e.g. atlas.json#people or topics/compute.json" },
        "filter": { "type": "object", "description": "Optional field=value filter applied to the dataset" },
        "hidden": { "type": "boolean" }
      },
      "additionalProperties": false } }
  }
}
