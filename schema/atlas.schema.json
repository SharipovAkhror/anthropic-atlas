{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atlas.schema.json",
  "title": "Anthropic Atlas core dataset (data/atlas.json)",
  "type": "object",
  "required": [
    "meta",
    "zones",
    "clusters",
    "facts",
    "shareClasses",
    "people",
    "products",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "company",
        "schemaVersion",
        "updatedAt"
      ],
      "properties": {
        "company": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 2
        },
        "updatedAt": {
          "$ref": "common.schema.json#/definitions/day"
        }
      },
      "additionalProperties": false
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "group"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "label": {
            "$ref": "common.schema.json#/definitions/i18nFull"
          },
          "group": {
            "enum": [
              "governance",
              "org"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "label": {
            "$ref": "common.schema.json#/definitions/i18nFull"
          }
        },
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "value",
          "asOf",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "$ref": "common.schema.json#/definitions/i18nFull"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "note": {
            "$ref": "common.schema.json#/definitions/i18n"
          },
          "asOf": {
            "$ref": "common.schema.json#/definitions/day"
          },
          "sources": {
            "$ref": "common.schema.json#/definitions/sources"
          }
        },
        "additionalProperties": false
      }
    },
    "shareClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "holder",
          "economics",
          "control"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "name": {
            "type": "string"
          },
          "holder": {
            "$ref": "common.schema.json#/definitions/i18n"
          },
          "economics": {
            "$ref": "common.schema.json#/definitions/i18n"
          },
          "control": {
            "$ref": "common.schema.json#/definitions/i18n"
          }
        },
        "additionalProperties": false
      }
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/person"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/product"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "to": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "type": {
            "enum": [
              "gov",
              "rep"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "person": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "zone",
        "status",
        "role",
        "since",
        "influence",
        "initials",
        "sources",
        "verifiedAt"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "person",
            "group"
          ]
        },
        "zone": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "status": {
          "enum": [
            "active",
            "former"
          ]
        },
        "role": {
          "$ref": "common.schema.json#/definitions/i18nFull"
        },
        "tag": {
          "$ref": "common.schema.json#/definitions/i18n"
        },
        "since": {
          "$ref": "common.schema.json#/definitions/date"
        },
        "until": {
          "$ref": "common.schema.json#/definitions/date"
        },
        "influence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "hero": {
          "type": "boolean"
        },
        "avatar": {
          "type": "string",
          "pattern": "^(https://|/assets/people/)"
        },
        "initials": {
          "type": "string",
          "pattern": "^[A-Z&]{1,3}$"
        },
        "bio": {
          "$ref": "common.schema.json#/definitions/i18n"
        },
        "sources": {
          "$ref": "common.schema.json#/definitions/sources"
        },
        "verifiedAt": {
          "$ref": "common.schema.json#/definitions/day"
        },
        "links": {
          "$ref": "common.schema.json#/definitions/links"
        },
        "avatarCredit": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "name",
        "cluster",
        "status",
        "released",
        "owners",
        "description",
        "sources",
        "verifiedAt"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "cluster": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "status": {
          "enum": [
            "active",
            "preview",
            "legacy",
            "retired"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 24
        },
        "released": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?([–-]\\d{4}(-\\d{2})?)?$"
        },
        "metrics": {
          "type": "string",
          "maxLength": 60
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          }
        },
        "description": {
          "$ref": "common.schema.json#/definitions/i18n"
        },
        "sources": {
          "$ref": "common.schema.json#/definitions/sources"
        },
        "verifiedAt": {
          "$ref": "common.schema.json#/definitions/day"
        },
        "links": {
          "$ref": "common.schema.json#/definitions/links"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "apiId": {
                "type": "string"
              },
              "released": {
                "$ref": "common.schema.json#/definitions/date"
              },
              "status": {
                "enum": [
                  "active",
                  "preview",
                  "deprecated",
                  "legacy",
                  "retired"
                ]
              },
              "note": {
                "$ref": "common.schema.json#/definitions/i18n"
              },
              "docs": {
                "type": "string",
                "pattern": "^https://"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
