{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opinions.schema.json",
  "title": "Opinions and forecasts about Anthropic by named professionals (data/opinions.json). Never facts: the page shows them apart.",
  "type": "object",
  "required": ["opinions"],
  "additionalProperties": false,
  "properties": {
    "opinions": { "type": "array", "items": {
      "type": "object",
      "required": ["id", "date", "kind", "who", "stance", "claim", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/id" },
        "date": { "$ref": "common.schema.json#/definitions/day", "description": "When it was published" },
        "kind": { "enum": ["forecast", "opinion", "analysis", "market"] },
        "who": { "type": "object", "required": ["name", "role"], "additionalProperties": false, "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 120 },
          "role": { "$ref": "common.schema.json#/definitions/i18n" } } },
        "stance": { "enum": ["bullish", "bearish", "mixed"] },
        "claim": { "$ref": "common.schema.json#/definitions/i18nFull", "description": "A paraphrase in our words, never a copied passage" },
        "horizon": { "type": ["string", "null"], "maxLength": 60 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/definitions/source" } },
        "addedAt": { "$ref": "common.schema.json#/definitions/day" }
      } } }
  }
}
