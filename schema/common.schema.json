{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Atlas shared definitions",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD"
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "i18n": {
      "type": "object",
      "required": [
        "ru"
      ],
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "uz": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "additionalProperties": false
    },
    "i18nFull": {
      "allOf": [
        {
          "$ref": "#/definitions/i18n"
        },
        {
          "required": [
            "ru",
            "en"
          ]
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "accessed": {
          "$ref": "#/definitions/day"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "links": {
      "type": "object",
      "description": "Reference links about the entity (who/what it is). Not evidence for claims; evidence lives in sources.",
      "properties": {
        "wikipedia": {
          "type": "string",
          "pattern": "^https://"
        },
        "wikidata": {
          "type": "string",
          "pattern": "^https://"
        },
        "official": {
          "type": "string",
          "pattern": "^https://"
        },
        "docs": {
          "type": "string",
          "pattern": "^https://"
        },
        "linkedin": {
          "type": "string",
          "pattern": "^https://"
        },
        "x": {
          "type": "string",
          "pattern": "^https://"
        },
        "github": {
          "type": "string",
          "pattern": "^https://"
        },
        "site": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "additionalProperties": false
    }
  }
}
