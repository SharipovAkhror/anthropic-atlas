{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "events.schema.json",
  "title": "Company event feed (data/events.json)",
  "type": "object",
  "required": ["events"],
  "additionalProperties": false,
  "properties": {
    "events": { "type": "array", "items": {
      "type": "object",
      "required": ["id", "date", "type", "importance", "title", "summary", "sources", "addedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 90 },
        "date": { "$ref": "common.schema.json#/definitions/day" },
        "type": { "enum": ["model", "product", "people", "governance", "finance", "policy", "research", "safety", "partnership", "legal", "infrastructure"] },
        "importance": { "enum": [1, 2, 3] },
        "title": { "$ref": "common.schema.json#/definitions/i18nFull" },
        "summary": { "$ref": "common.schema.json#/definitions/i18n" },
        "entities": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/id" } },
        "sources": { "$ref": "common.schema.json#/definitions/sources" },
        "addedAt": { "$ref": "common.schema.json#/definitions/day" }
      },
      "additionalProperties": false } }
  }
}
